outputs/cf_mining/training_global_gate/*
!outputs/cf_mining/training_global_gate/*.json
!outputs/cf_mining/training_global_gate/*.jsonl
!outputs/cf_mining/training_global_gate/*/
outputs/cf_mining/training_global_gate/*/*
!outputs/cf_mining/training_global_gate/*/*.json
!outputs/cf_mining/training_global_gate/*/*.jsonl
!outputs/cf_mining/training_global_readout/
outputs/cf_mining/training_global_readout/*
!outputs/cf_mining/training_global_readout/*.json
!outputs/cf_mining/training_global_readout/*.jsonl
!outputs/cf_mining/training_global_readout/*/
outputs/cf_mining/training_global_readout/*/*
!outputs/cf_mining/training_global_readout/*/*.json
!outputs/cf_mining/training_global_readout/*/*.jsonl
!outputs/cf_mining/report/
