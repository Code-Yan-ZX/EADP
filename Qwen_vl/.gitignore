# Python
__pycache__/
*.py[cod]

# Local environments
.env
.venv/
venv/
env/

# Generated outputs
#
# The discovery deliverables under outputs/discovery/*.json are the evidence for
# docs/scoring_search_*.md and are tracked on purpose, so `outputs/` is excluded
# by contents rather than wholesale. Everything else in outputs/ -- notably the
# S2-C1 feature caches (7.4 GB of *.npy) and the *.pt scorer weights -- stays
# ignored, as do *.log run records. The root .gitignore repeats the binary rules
# for other trees.
outputs/*
!outputs/discovery/
outputs/discovery/*
!outputs/discovery/*.json
# E0 deliverables: plan/gates/accuracy/perf/verdict JSONs plus the progress
# note and the Pareto figure, same evidence convention as outputs/discovery.
!outputs/e0/
outputs/e0/*
!outputs/e0/*.json
# E0 accuracy shards: only the official-score summaries are evidence; the
# per-question prediction TSVs and shard JSONs stay local (regenerable).
!outputs/e0/acc/
outputs/e0/acc/*
!outputs/e0/acc/*/
outputs/e0/acc/*/*
!outputs/e0/acc/*/*/*_score.json
!outputs/e0/*.md
!outputs/e0/figures/
outputs/e0/figures/*
!outputs/e0/figures/*.png
# M2 deliverable: the accuracy-efficiency Pareto figure (a few hundred kB, and
# the report's central exhibit). Every other figure stays ignored.
!outputs/discovery/figures/
outputs/discovery/figures/*
!outputs/discovery/figures/m2_*.png
!outputs/discovery/figures/s3a_*.png
# S3-B deliverable: the bundle-structure figure (report's central exhibit).
!outputs/discovery/figures/s3b_*.png
# M4-v0 deliverable: the REC mechanism, profile, diagnostics and case figures.
!outputs/discovery/figures/m4_*.png
logs/
*.log
*.out
*.err

# Model/data/cache directories
checkpoints/
models/
datasets/
LMUData/
.cache/
hf_cache/

# Editor/system files
.DS_Store
.idea/
.vscode/
# M12 deliverables: gate/oracle/diag/analysis JSONs plus official-score
# summaries, same evidence convention as outputs/e0. Prediction shards and
# TSV/xlsx stay local (regenerable from the scripts).
!outputs/m12/
outputs/m12/*
!outputs/m12/*.json
!outputs/m12/acc/
outputs/m12/acc/*
!outputs/m12/acc/*/
outputs/m12/acc/*/*
!outputs/m12/acc/*/*/*_score.json
# Anchor-Merge Pilot deliverables: manifest, frozen anchor banks, correctness,
# analysis and paired-perf JSONs plus official-score summaries (with per-
# question scores inside), same evidence convention as outputs/e0. Prediction
# shards, run logs and TSV/xlsx stay local (regenerable via run_all.sh).
!outputs/anchor_merge_pilot/
outputs/anchor_merge_pilot/*
!outputs/anchor_merge_pilot/*.json
!outputs/anchor_merge_pilot/bank_*.json.gz
!outputs/anchor_merge_pilot/acc/
outputs/anchor_merge_pilot/acc/**
!outputs/anchor_merge_pilot/acc/**/
!outputs/anchor_merge_pilot/acc/**/*_score.json
